    "required_state": "u3_component_benchmark_accepted=true"
  },
  "fluid": "CO2",
  "property_backend": {
    "name": "CoolProp",
    "version": "8.0.0"
  },
  "upstream_state_families": [
    {
      "state_id": "LIQUID_LIMIT",
      "purpose": "B0 small-pressure-drop limiting comparison and unchoked liquid path only",
      "pressure_pa": 5000000.0,
      "temperature_definition": "T_sat(P=5.0e6,Q=0,CO2)-5.0 K",
      "subcooling_K": 5.0,
      "velocity_m_s": 0.0,
      "allowed_normalized_phases": [
        "liquid"
      ],
      "critical_state_search_required": false
    },
    {
      "state_id": "GAS_CRITICAL",
      "purpose": "single-phase gas critical-state and choking benchmark",
      "pressure_pa": 1000000.0,
      "temperature_K": 320.0,
      "velocity_m_s": 0.0,
      "allowed_normalized_phases": [
        "gas",
        "supercriticalgas"
      ],
      "critical_state_search_required": true
    }
  ],
  "stagnation_property_definitions": {
    "h0": "CoolProp HMASS at fixed upstream P,T",
    "s0": "CoolProp SMASS at fixed upstream P,T",
    "rho0": "CoolProp DMASS at fixed upstream P,T",
    "candidate_h": "CoolProp HMASS at candidate P and fixed s0",
    "candidate_rho": "CoolProp DMASS at candidate P and fixed s0",
    "candidate_phase": "CoolProp PhaseSI at candidate P and fixed s0"
  },
  "geometry_and_coefficients": {
    "reference_area_m2": 0.0001,
    "base_opening_fraction": 0.5,
    "base_effective_area_m2": 0.00005,
    "base_discharge_coefficient": 0.8
  },
  "sign_and_transfer_convention": {
    "positive_direction": "out_of_modeled_domain",
    "thermodynamic_ideal_velocity": "sqrt(2*(h0-h_candidate))",
    "effective_stream_velocity": "Cd*thermodynamic_ideal_velocity",
    "effective_mass_flux": "rho_candidate*effective_stream_velocity",
    "mass_flow_rate": "Aeff*effective_mass_flux",
    "mass_transfer": "m_dot",
    "momentum_stream_transfer": "m_dot*effective_stream_velocity",
    "energy_transfer": "m_dot*h0",
    "static_pressure_force": "not_included; deferred_to_future_FVM_face_mapping",
    "closed_or_zero_drop": "exact_zero_mass_momentum_energy_stream_transfer"
  },
  "isentropic_candidate_law": {
    "entropy_constraint": "s_candidate=s0",
    "kinetic_energy_head_J_kg": "h0-h_candidate",
    "ideal_velocity_m_s": "sqrt(2*(h0-h_candidate)) when h0-h_candidate>0",
    "effective_velocity_m_s": "Cd*ideal_velocity_m_s",
    "ideal_mass_flux_kg_m2_s": "rho_candidate*ideal_velocity_m_s",
    "effective_mass_flux_kg_m2_s": "Cd*ideal_mass_flux_kg_m2_s",
    "mass_flow_rate_kg_s": "Aeff*effective_mass_flux_kg_m2_s",
    "coefficient_placement": "Cd multiplies ideal velocity and mass flux; critical pressure is therefore Cd-independent",
    "B0_limit_mapping": "for small liquid pressure drop, effective_velocity approaches Cd*sqrt(2*Delta_p/rho0)"
  },
  "single_phase_admissibility": {
    "phase_normalization": "lowercase and remove underscore and spaces",
    "candidate_phase_must_be_in_state_family_allowlist": true,
    "two_phase_candidates_prohibited": true,
    "candidate_density_must_be_positive_finite": true,
    "candidate_enthalpy_entropy_must_be_finite": true,
    "kinetic_energy_head_must_be_positive_except_exact_zero_drop": true,
    "path_termination": "first non-admissible candidate terminates retained single-phase path; no interpolation through two phase"
  },
  "critical_state_search": {
    "applies_to_state_id": "GAS_CRITICAL",
    "coarse_pressure_ratio_upper": 1.0,
    "coarse_pressure_ratio_lower": 0.05,
    "coarse_node_count": 4097,
    "coarse_spacing": "uniform_in_pressure_ratio_descending",
    "coarse_argmax_rule": "maximum effective mass flux; ties choose highest pressure",
    "required_bracket": "coarse argmax must have one admissible neighbor on each pressure side",
    "refinement_method": "deterministic_golden_section_maximization_in_pressure",
    "refinement_pressure_bracket_tolerance_pa": 1.0,
    "refinement_max_iterations": 128,
    "final_selection": "maximum of refined point and retained bracket endpoints; ties choose highest pressure",
    "critical_state_must_be_interior": true,
    "critical_pressure_classification_tolerance_pa": 1.0,
    "peak_neighbor_relative_offset": 0.0001,
    "minimum_peak_prominence_relative": 1e-08
  },
  "back_pressure_rule": {
    "reverse_pressure": "pb>p0 is refused",
    "zero_drop": "pb=p0 gives exact zero transfer",
    "unchoked": "pb>p_critical+tolerance; evaluate isentropic state at pb",
    "choked": "pb<=p_critical+tolerance; evaluate transfers at p_critical",
    "below_critical_plateau": "mass flow and retained stream transfers are independent of further back-pressure reduction within locked tolerances",
    "reverse_flow": "unsupported"
  },
  "formal_outcomes": [
    "SUCCESS_CLOSED",
    "SUCCESS_ZERO_PRESSURE_DROP",
    "SUCCESS_UNCHOKED_SINGLE_PHASE_DISCHARGE",
    "SUCCESS_CHOKED_SINGLE_PHASE_DISCHARGE",
    "NONFINITE_INPUT",
    "OPENING_OUTSIDE_UNIT_INTERVAL",
    "NONPOSITIVE_REFERENCE_AREA",
    "NONPOSITIVE_DISCHARGE_COEFFICIENT",
    "REVERSE_PRESSURE_NOT_SUPPORTED",
    "UPSTREAM_STATE_OUTSIDE_DECLARED_PHASE_SCOPE",
    "SINGLE_PHASE_PATH_SCOPE_FAILURE",
    "PROPERTY_BACKEND_FAILURE",
